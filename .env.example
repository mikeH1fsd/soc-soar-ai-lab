# ==============================================================================
# Enterprise SOC & SOAR Automation Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace dummy placeholders with actual credentials.
# NEVER commit the actual .env file to public version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WAZUH MANAGER REST API CONFIGURATION
# ------------------------------------------------------------------------------
# Address and port of the Wazuh Manager (Default REST API port: 55000)
WAZUH_API_URL=https://192.168.109.158:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=YourWazuhManagerStrongPasswordHere
WAZUH_SSL_VERIFY=false

# ------------------------------------------------------------------------------
# 2. ATLASSIAN JIRA CLOUD REST API v3
# ------------------------------------------------------------------------------
# Base URL for your Jira Cloud instance
JIRA_CLOUD_URL=https://your-soc-domain.atlassian.net
# Email address associated with your Atlassian API token
JIRA_USER_EMAIL=soc-automation@yourdomain.com
# Jira API Token generated from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here
# Target project key where security incident tickets are created
JIRA_PROJECT_KEY=SA
JIRA_ISSUE_TYPE=Bug

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI GENERATIVE AI (ALERT ANALYSIS)
# ------------------------------------------------------------------------------
# Google AI Studio API Key from https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGoogleGeminiApiKeyHere
# Recommended model: gemini-2.5-flash for low-latency triage
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. VIRUSTOTAL CTI API v3
# ------------------------------------------------------------------------------
# Free/Enterprise API Key from https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key_v3_here

# ------------------------------------------------------------------------------
# 5. SHUFFLE SOAR WEBHOOK ENDPOINTS
# ------------------------------------------------------------------------------
# Webhook URLs generated inside Shuffle SOAR workflows
SHUFFLE_WEBHOOK_NMAP_RECON=https://shuffler.io/api/v1/hooks/webhook_669202e8-00cf-4f1d-bca6-2a005a2fec8e
SHUFFLE_WEBHOOK_FIM_MALWARE=https://shuffler.io/api/v1/hooks/webhook_1650f37e-0dce-4aac-90bc-ce5ff735d39f
SHUFFLE_WEBHOOK_GEMINI_TRIAGE=https://shuffler.io/api/v1/hooks/webhook_ae619d51-8040-4197-8571-2d911e786ec1
SHUFFLE_WEBHOOK_IPTABLES_BLOCK=https://shuffler.io/api/v1/hooks/webhook_nmap_block_ip
SHUFFLE_WEBHOOK_WINDOWS_DELETE=https://shuffler.io/api/v1/hooks/webhook_10d55ea2-01c2-4b9a-9640-d5f01d2a4e97
