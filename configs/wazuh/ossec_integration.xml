<!-- Wazuh Manager Webhook Integrations (/var/ossec/etc/ossec.conf) -->

<!-- Playbook 1: LSASS Memory Dump (Rule 100200) -->
<integration>
  <name>shuffle</name>
  <hook_url>https://shuffler.io/api/v1/hooks/webhook_PLAYBOOK1_LSASS_ID</hook_url>
  <rule_id>100200</rule_id>
  <alert_format>json</alert_format>
</integration>

