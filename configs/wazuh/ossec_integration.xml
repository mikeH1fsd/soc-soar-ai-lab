<!-- Wazuh Integration Block for Shuffle SOAR Webhook -->
<!-- Add before </ossec_config> in /var/ossec/etc/ossec.conf -->

<integration>
  <name>shuffle</name>
  <hook_url>https://shuffler.io/api/v1/hooks/webhook_YOUR_SHUFFLE_WEBHOOK_ID</hook_url>
  <!-- Only forward high-fidelity incident rules to avoid SOAR alert fatigue -->
  <rule_id>100002,100055</rule_id>
  <alert_format>json</alert_format>
</integration>
