<!-- Custom Active Response for Windows Malware Eradication (/var/ossec/etc/ossec.conf) -->
<command>
  <name>remove-threat</name>
  <executable>remove-threat.cmd</executable>
  <timeout_allowed>no</timeout_allowed>
</command>

<!-- Dummy Active Response (rule_id 999999) to force command sync down to Windows agents -->
<active-response>
  <command>remove-threat</command>
  <location>local</location>
  <rules_id>999999</rules_id>
</active-response>
