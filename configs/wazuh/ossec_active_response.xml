<!-- ==============================================================================
     Wazuh Manager Active Response & Command Configurations
     File Location on Wazuh Manager: /var/ossec/etc/ossec.conf
     Place these blocks inside <ossec_config> before the closing </ossec_config> tag.
     Restart service: sudo systemctl restart wazuh-manager
     Verification command: sudo /var/ossec/bin/agent_control -L
============================================================================== -->

<!-- ==============================================================================
     1. CUSTOM ACTIVE RESPONSE: Windows Malware Eradication (Playbook 3)
     Target: Windows Endpoint (Active Response Script: remove-threat.cmd)
============================================================================== -->
<command>
  <name>remove-threat</name>
  <executable>remove-threat.cmd</executable>
  <timeout_allowed>no</timeout_allowed>
</command>

<!-- Wazuh 4.x Agent Synchronization Registration:
     In Wazuh 4.x, custom <command> definitions are not pushed down to Windows agents
     unless associated with an <active-response> tag in ossec.conf.
     Because remediation is triggered on-demand via Jira Human-in-the-Loop REST API,
     we declare a dummy active-response block with a non-existent rule_id (999999).
     This forces the Manager to register 'remove-threat.cmd' into the agent's ar.conf
     while preventing automated premature execution without human authorization. -->
<active-response>
  <command>remove-threat</command>
  <location>local</location>
  <rules_id>999999</rules_id>
</active-response>

<!-- ==============================================================================
     2. NATIVE ACTIVE RESPONSE: Linux Host Firewall Isolation (Playbook 2)
     Note: 'firewall-drop' is a pre-installed built-in script located on Linux agents
     at /var/ossec/active-response/bin/firewall-drop.
     Because it is a native Wazuh command, it requires NO additional <command> XML
     configuration in ossec.conf. Shuffle SOAR invokes it directly via the Wazuh
     Manager REST API by prefixing the command with an exclamation mark:
     POST /active-response with body: {"command": "!firewall-drop"}
============================================================================== -->
